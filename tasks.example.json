{
  "version": 1,
  "defaults": {
    "site": "e",
    "download_mode": "archive-original",
    "archive_connections": 8,
    "gallery_workers": 1,
    "page_workers": 3,
    "timeout": 60,
    "delay": 0,
    "retries": 3,
    "retry_backoff": 2,
    "output": "F:\\eh_downloads",
    "cookie_file": "F:\\WORK\\codex\\eh_cookies.txt",
    "hosts": "system",
    "proxy_mode": "system",
    "keep_going": true
  },
  "configs": [
    {
      "name": "touhou-baiyang-nonh",
      "enabled": true,
      "interval_minutes": 360,
      "server_conditions": [
        {"type": "Search", "value": "language:chinese$"},
        {"type": "Search", "value": "parody:\"touhou project$\""}
      ],
      "categories": ["non-h"],
      "local_filters": [
        {"type": "Title Contains", "value": "白杨汉化组"}
      ],
      "max_list_pages": 20
    },
    {
      "name": "uploader-example",
      "enabled": false,
      "interval_minutes": 360,
      "server_conditions": [
        {"type": "Uploader", "value": "uploader_a"},
        {"type": "Uploader", "value": "uploader_b"}
      ],
      "categories": ["doujinshi", "manga", "non-h"],
      "max_list_pages": 5
    },
    {
      "name": "tag-example",
      "enabled": false,
      "interval_minutes": 360,
      "server_conditions": [
        {"type": "Search", "value": "artist:example$"}
      ],
      "categories": ["doujinshi", "manga"],
      "max_list_pages": 5
    }
  ]
}
